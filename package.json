{
  "name": "aidlc-panel",
  "displayName": "AI-DLC Panel",
  "description": "%ext.description%",
  "version": "0.7.0",
  "publisher": "foundA",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aidlcPanel",
          "title": "AI-DLC",
          "icon": "media/aidlc.svg"
        }
      ]
    },
    "views": {
      "aidlcPanel": [
        {
          "id": "aidlcPanelOverview",
          "name": "%view.overview.name%",
          "type": "webview"
        },
        {
          "id": "aidlcPanelActions",
          "name": "%view.actions.name%"
        },
        {
          "id": "aidlcPanelProgress",
          "name": "%view.progress.name%"
        },
        {
          "id": "aidlcPanelArtifacts",
          "name": "%view.artifacts.name%"
        },
        {
          "id": "aidlcPanelReference",
          "name": "%view.reference.name%"
        },
        {
          "id": "aidlcPanelTips",
          "name": "%view.tips.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "aidlcPanel.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "aidlcPanel.setLanguage",
        "title": "%cmd.setLanguage%",
        "icon": "$(globe)"
      },
      {
        "command": "aidlcPanel.switchIntent",
        "title": "%cmd.switchIntent%",
        "icon": "$(list-selection)"
      },
      {
        "command": "aidlcPanel.showAuxOn",
        "title": "%cmd.showAuxOn%",
        "icon": "$(eye)"
      },
      {
        "command": "aidlcPanel.showAuxOff",
        "title": "%cmd.showAuxOff%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "aidlcPanel.runNextStage",
        "title": "%cmd.runNextStage%",
        "icon": "$(run)"
      },
      {
        "command": "aidlcPanel.hideCompletedOn",
        "title": "%cmd.hideCompletedOn%",
        "icon": "$(check-all)"
      },
      {
        "command": "aidlcPanel.hideCompletedOff",
        "title": "%cmd.hideCompletedOff%",
        "icon": "$(check)"
      },
      {
        "command": "aidlcPanel.hideSkippedOn",
        "title": "%cmd.hideSkippedOn%",
        "icon": "$(eye)"
      },
      {
        "command": "aidlcPanel.hideSkippedOff",
        "title": "%cmd.hideSkippedOff%",
        "icon": "$(circle-slash)"
      },
      {
        "command": "aidlcPanel.openFullDashboard",
        "title": "%cmd.openFullDashboard%",
        "icon": "$(browser)"
      },
      {
        "command": "aidlcPanel.showStage",
        "title": "%cmd.showStage%"
      },
      {
        "command": "aidlcPanel.showTip",
        "title": "%cmd.showTip%"
      },
      {
        "command": "aidlcPanel.openUrl",
        "title": "%cmd.openUrl%"
      },
      {
        "command": "aidlcPanel.openArtifact",
        "title": "%cmd.openArtifact%"
      },
      {
        "command": "aidlcPanel.askKiro",
        "title": "%cmd.askKiro%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aidlcPanel.askKiroArtifact",
        "title": "%cmd.askKiroArtifact%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aidlcPanel.probeChatCommands",
        "title": "%cmd.probeChatCommands%"
      },
      {
        "command": "aidlcPanel.parkToggle",
        "title": "%cmd.parkToggle%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "aidlcPanel.init",
        "title": "%cmd.init%"
      },
      {
        "command": "aidlcPanel.editArtifact",
        "title": "%cmd.editArtifact%",
        "icon": "$(edit)"
      },
      {
        "command": "aidlcPanel.viewArtifact",
        "title": "%cmd.viewArtifact%",
        "icon": "$(preview)"
      },
      {
        "command": "aidlcPanel.diffArtifact",
        "title": "%cmd.diffArtifact%",
        "icon": "$(git-compare)"
      },
      {
        "command": "aidlcPanel.toggleReviewed",
        "title": "%cmd.toggleReviewed%"
      },
      {
        "command": "aidlcPanel.markReviewed",
        "title": "%cmd.markReviewed%",
        "icon": "$(check)"
      },
      {
        "command": "aidlcPanel.unmarkReviewed",
        "title": "%cmd.unmarkReviewed%",
        "icon": "$(x)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aidlcPanel.hideCompletedOn",
          "when": "view == aidlcPanelProgress && !aidlcPanel.hideCompleted",
          "group": "navigation@1"
        },
        {
          "command": "aidlcPanel.hideCompletedOff",
          "when": "view == aidlcPanelProgress && aidlcPanel.hideCompleted",
          "group": "navigation@1"
        },
        {
          "command": "aidlcPanel.hideSkippedOn",
          "when": "view == aidlcPanelProgress && !aidlcPanel.hideSkipped",
          "group": "navigation@2"
        },
        {
          "command": "aidlcPanel.hideSkippedOff",
          "when": "view == aidlcPanelProgress && aidlcPanel.hideSkipped",
          "group": "navigation@2"
        },
        {
          "command": "aidlcPanel.showAuxOn",
          "when": "view == aidlcPanelArtifacts && !aidlcPanel.showAux",
          "group": "navigation@0"
        },
        {
          "command": "aidlcPanel.showAuxOff",
          "when": "view == aidlcPanelArtifacts && aidlcPanel.showAux",
          "group": "navigation@0"
        },
        {
          "command": "aidlcPanel.setLanguage",
          "when": "view == aidlcPanelActions",
          "group": "navigation@1"
        },
        {
          "command": "aidlcPanel.refresh",
          "when": "view == aidlcPanelActions",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "aidlcPanel.viewArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem == artifact-questions",
          "group": "inline@0"
        },
        {
          "command": "aidlcPanel.editArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem =~ /^(artifact-(un)?reviewed|artifact-aux|artifact-questions)$/",
          "group": "inline@1"
        },
        {
          "command": "aidlcPanel.askKiroArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem =~ /^(artifact-(un)?reviewed|artifact-aux|artifact-questions)$/",
          "group": "inline@2"
        },
        {
          "command": "aidlcPanel.diffArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem =~ /^(artifact-(un)?reviewed|artifact-aux|artifact-questions)$/",
          "group": "inline@3"
        },
        {
          "command": "aidlcPanel.markReviewed",
          "when": "view == aidlcPanelArtifacts && viewItem == artifact-unreviewed",
          "group": "inline@4"
        },
        {
          "command": "aidlcPanel.unmarkReviewed",
          "when": "view == aidlcPanelArtifacts && viewItem == artifact-reviewed",
          "group": "inline@4"
        },
        {
          "command": "aidlcPanel.viewArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem == artifact-questions",
          "group": "1_actions@0"
        },
        {
          "command": "aidlcPanel.editArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem =~ /^(artifact-(un)?reviewed|artifact-aux|artifact-questions)$/",
          "group": "1_actions@1"
        },
        {
          "command": "aidlcPanel.askKiroArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem =~ /^(artifact-(un)?reviewed|artifact-aux|artifact-questions)$/",
          "group": "1_actions@2"
        },
        {
          "command": "aidlcPanel.diffArtifact",
          "when": "view == aidlcPanelArtifacts && viewItem =~ /^(artifact-(un)?reviewed|artifact-aux|artifact-questions)$/",
          "group": "1_actions@3"
        },
        {
          "command": "aidlcPanel.markReviewed",
          "when": "view == aidlcPanelArtifacts && viewItem == artifact-unreviewed",
          "group": "1_actions@4"
        },
        {
          "command": "aidlcPanel.unmarkReviewed",
          "when": "view == aidlcPanelArtifacts && viewItem == artifact-reviewed",
          "group": "1_actions@4"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.4.0"
  }
}
